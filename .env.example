# Copy to .env and adjust. Never commit real credentials.

# PostgreSQL connection (server-side only).
# Local default matches docker-compose.yml (`npm run db:up`).
DATABASE_URL="postgresql://aneakajun:aneakajun@127.0.0.1:55434/aneakajun_hub"

# Public base URL: used for canonical URLs, hreflang, Open Graph, sitemap and share links.
SITE_URL="http://localhost:3000"

# Where uploaded images are stored on disk (relative to the project root).
# On a server, point this at a persistent volume, or swap the storage
# provider in src/lib/storage for S3-compatible object storage.
STORAGE_DIR="storage/uploads"

# DEVELOPMENT ONLY: password for the seeded accounts (see docs/DEVELOPMENT.md).
# SEED_ADMIN_PASSWORD="choose-a-dev-password"
